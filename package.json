{
  "name": "codex-agents-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.13",
    "@astrojs/svelte": "9.1.6",
    "astro": "7.4.12",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.0.0",
    "svelte-check": "4.7.8",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
