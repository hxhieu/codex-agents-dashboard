---
import Dashboard from '../components/Dashboard.svelte';
import '../styles/theme.css';

const { android = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Live activity from your Codex CLI sessions across the local network." />
    <meta name="theme-color" content="#f4f5ef" />
    <script is:inline src="/theme.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Codex / Agents</title>
  </head>
  <body><Dashboard client:load {android} /></body>
</html>
